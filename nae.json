{
    "$schema": "node_modules/@netgrif/components-core/src/schema/nae-schema.json",
    "extends": "nae-default",
    "autoResolveBackendUrl": false,
    "providers": {
        "auth": {
            "address": "http://localhost:8080/api",
            "authentication": "Basic",
            "endpoints": {
                "login": "/auth/login",
                "logout": "/auth/logout",
                "signup": "/auth/signup"
            },
            "sessionBearer": "X-Auth-Token"
        },
        "resources": [
            {
                "name": "main",
                "address": "http://localhost:8080/api"
            },
            {
                "name": "case",
                "address": "http://localhost:8080/api"
            },
            {
                "name": "task",
                "address": "http://localhost:8080/api"
            },
            {
                "name": "petrinet",
                "address": "http://localhost:8080/api"
            },
            {
                "name": "user",
                "address": "http://localhost:8080/api"
            }
        ]
    },
    "views": {
        "login": {
            "layout": {
                "name": "login",
                "componentName": "Login"
            },
            "component": {
                "class": "LoginComponent",
                "from": "./views/login/login.component"
            },
            "access": "public",
            "navigation": false,
            "routing": {
                "path": "login"
            }
        },
        "side-nav": {
            "layout": {
                "name": "sidenavView",
                "componentName": "Sidenav",
                "params": {
                    "user": true,
                    "quickPanel": true,
                    "navigation": true
                }
            },
            "component": {
                "class": "SidenavComponent",
                "from": "./views/side-nav/side-nav-sidenav-view.component"
            },
            "access": "private",
            "navigation": false,
            "routing": {
                "path": ""
            },
            "children": {
                "group-navigation-double-drawer-outlet": {
                    "layout": {
                        "name": "groupNavigation"
                    },
                    "navigation": false,
                    "routing": {
                        "path": "filter"
                    }
                },
                "profile": {
                    "component": {
                        "class": "ProfileComponent",
                        "from": "@netgrif/components"
                    },
                    "access": "private",
                    "navigation": true,
                    "routing": {
                        "path": "profile"
                    }
                },
                "console": {
                    "component": {
                        "class": "RoleAssignmentComponent",
                        "from": "@netgrif/components"
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "developer_board",
                        "title": "Console",
                        "translate": true,
                        "hidden": true
                    },
                    "routing": {
                        "path": "console"
                    }
                },
                "workflow": {
                    "component": {
                        "class": "WorkflowViewComponent",
                        "from": "@netgrif/components"
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "settings",
                        "title": "Workflow",
                        "translate": true,
                        "hidden": true
                    },
                    "routing": {
                        "path": "workflow-view"
                    }
                }
            }
        },
        "all-cases": {
            "component": {
                "class": "AllCasesTabView",
                "from": "./views/all-cases/all-cases.component"
            },
            "access": "private",
            "navigation": false,
            "routing": {
                "path": "cases"
            }
        },
        "my-cases": {
            "component": {
                "class": "MyCasesTabView",
                "from": "./views/my-cases/my-cases.component"
            },
            "access": "private",
            "navigation": false,
            "routing": {
                "path": "my-cases"
            }
        },
        "all-tasks": {
            "component": {
                "class": "AllTasks",
                "from": "./views/all-tasks/all-tasks.component"
            },
            "access": "private",
            "navigation": false,
            "routing": {
                "path": "tasks"
            }
        },
        "my-tasks": {
            "component": {
                "class": "MyTasks",
                "from": "./views/my-tasks/my-tasks.component"
            },
            "access": "private",
            "navigation": false,
            "routing": {
                "path": "my-tasks"
            }
        },
        "emptyView": {
            "layout": {
                "name": "emptyView",
                "componentName": "EmptyView"
            },
            "access": "private",
            "navigation": true,
            "routing": {
                "path": "empty"
            }
        },
        "task-list-view": {
            "component": {
                "class": "DefaultSimpleTaskViewComponent"
            },
            "access": "private",
            "routing": {
                "path": "task-list/:singleCaseId"
            }
        },
        "single-public-task": {
            "component": {
                "class": "PublicSingleTaskViewComponent"
            },
            "access": "public",
            "navigation": {
                "title": "Public view - transition"
            },
            "routing": {
                "path": "process/:petriNetId/:caseId/:transitionId"
            }
        },
        "public-view": {
            "component": {
                "class": "PublicTaskViewComponent"
            },
            "access": "public",
            "navigation": {
                "title": "Public view - task"
            },
            "routing": {
                "path": "process/:petriNetId/:caseId"
            }
        },
        "public-view-case": {
            "component": {
                "class": "PublicTaskViewComponent"
            },
            "access": "public",
            "navigation": {
                "title": "Public view - case"
            },
            "routing": {
                "path": "process/:petriNetId"
            }
        },
        "public-view-workflow": {
            "component": {
                "class": "PublicWorkflowViewComponent"
            },
            "access": "public",
            "navigation": {
                "title": "Public view - process"
            },
            "routing": {
                "path": "process"
            }
        },
        "public-view-resolver": {
            "component": {
                "class": "PublicResolverComponent"
            },
            "access": "public",
            "navigation": true,
            "routing": {
                "path": "public-resolver"
            }
        }
    },
    "theme": {
        "name": "default",
        "pallets": {
            "light": {
                "primary": "#2196F3",
                "secondary": "#FFC107",
                "warn": "red"
            }
        }
    },
    "assets": [
        "src/assets"
    ],
    "filters": {
        "all-cases": {
            "title": "All Cases",
            "access": "public",
            "query": {},
            "type": "Case"
        }
    },
    "i18n": [
        "sk-SK",
        "de-DE",
        "en-US"
    ],
    "services": {
        "auth": {
            "logoutRedirect": "login",
            "loginRedirect": "login"
        },
        "groupNavigation": {
            "groupNavigationRoute": "filter"
        },
        "log": {
            "level": "DEBUG",
            "logWithDate": true,
            "serializeExtraParams": true,
            "includeLogLevel": true,
            "publishers": [
                "console"
            ]
        }
    }
}
