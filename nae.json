{
    "$schema": "node_modules/@netgrif/components-core/src/schema/nae-schema.json",
    "extends": "nae-default",
    "autoResolveBackendUrl": false,
    "providers": {
        "auth": {
            "address": "http://localhost:8800/api/",
            "authentication": "BasicWithRealm",
            "endpoints": {
                "login": "auth/login",
                "logout": "auth/logout",
                "signup": "auth/signup",
                "changePassword": "auth/changePassword",
                "verification": "auth/verify",
                "verify": "auth/token/verify",
                "invite": "auth/invite",
                "reset": "auth/reset",
                "recover": "auth/recover"
            },
            "sessionBearer": "X-Auth-Token",
            "sessionTimeoutEnabled": false,
            "sessionTimeout": 900,
            "jwtBearer": "X-Jwt-Token",
            "sso": {
                "enable": false,
                "clientId": "dev-cluster-worker",
                "redirectUrl": "http://localhost:8081/realms/netgrif-cloud-testing/protocol/openid-connect/auth",
                "refreshUrl": "http://localhost:8800/api/auth/login",
                "scopes": ["openid","email","profile","roles"]
            }
        },
        "resources": [
            {
                "name": "main",
                "address": "http://localhost:8800/api/"
            },
            {
                "name": "case",
                "address": "http://localhost:8800/api/"
            },
            {
                "name": "task",
                "address": "http://localhost:8800/api/"
            },
            {
                "name": "petrinet",
                "address": "http://localhost:8800/api/"
            },
            {
                "name": "user",
                "address": "http://localhost:8800/api/"
            }
        ]
    },
    "views": {
        "login": {
            "layout": {
                "name": "login",
                "componentName": "Login"
            },
            "component": {
                "class": "LoginComponent",
                "from": "./views/login/login.component"
            },
            "access": "public",
            "navigation": false,
            "routing": {
                "path": "login"
            }
        },
        "side-nav": {
            "layout": {
                "name": "sidenavView",
                "componentName": "Sidenav",
                "params": {
                    "user": true,
                    "quickPanel": true,
                    "navigation": true
                }
            },
            "component": {
                "class": "SidenavComponent",
                "from": "./views/side-nav/side-nav-sidenav-view.component"
            },
            "access": "private",
            "navigation": false,
            "routing": {
                "path": ""
            },
            "children": {
                "cases": {
                    "layout": {
                        "name": "caseView",
                        "params": {},
                        "enableCaseTitle": true,
                        "isCaseTitleRequired": true
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "fact_check",
                        "title": "All Cases"
                    },
                    "routing": {
                        "path": "cases"
                    }
                },
                "tasks": {
                    "layout": {
                        "name": "taskView",
                        "params": {}
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "assignment",
                        "title": "All Tasks"
                    },
                    "routing": {
                        "path": "tasks"
                    }
                },
                "tabViewAllCase": {
                    "layout": {
                        "name": "tabView",
                        "componentName": "tabViewAllCase",
                        "params": {
                            "tabs": [
                                {
                                    "view": {
                                        "name": "caseView"
                                    },
                                    "label": {
                                        "icon": "storage",
                                        "text": "All Cases"
                                    },
                                    "canBeClosed": false,
                                    "order": -2
                                },
                                {
                                    "view": {
                                        "name": "caseView"
                                    },
                                    "label": {
                                        "icon": "face",
                                        "text": "My Cases"
                                    },
                                    "canBeClosed": false,
                                    "order": -1
                                }
                            ],
                            "defaultTaskView": {
                                "view": {
                                    "name": "taskView"
                                }
                            }
                        }
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "tab",
                        "title": "Tab View"
                    },
                    "routing": {
                        "path": "tabView"
                    }
                },
                "emptyView": {
                    "layout": {
                        "name": "emptyView",
                        "componentName": "EmptyView"
                    },
                    "access": "private",
                    "navigation": true,
                    "routing": {
                        "path": "empty"
                    }
                },
                "workflows": {
                    "component": {
                        "class": "WorkflowViewComponent",
                        "from": "@netgrif/components"
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "linear_scale",
                        "title": "Workflow",
                        "translate": true
                    },
                    "routing": {
                        "path": "workflows"
                    }
                },
                "console": {
                    "component": {
                        "class": "RoleAssignmentComponent",
                        "from": "@netgrif/components"
                    },
                    "access": "private",
                    "navigation": {
                        "icon": "developer_board",
                        "title": "Console",
                        "translate": true
                    },
                    "routing": {
                        "path": "console"
                    }
                }
            }
        }
    },
    "theme": {
        "name": "default",
        "pallets": {
            "light": {
                "primary": {
                    "50": "",
                    "100": "",
                    "200": "",
                    "300": "",
                    "400": "",
                    "500": "",
                    "600": "",
                    "700": "",
                    "800": "",
                    "900": "",
                    "A100": "",
                    "A200": "",
                    "A400": "",
                    "A700": "",
                    "contrast": {
                        "light": [
                            "300",
                            "400",
                            "500",
                            "600",
                            "700",
                            "800",
                            "900"
                        ],
                        "dark": [
                            "50",
                            "100",
                            "200"
                        ]
                    }
                },
                "secondary": {
                    "50": "",
                    "100": "",
                    "200": "",
                    "300": "",
                    "400": "",
                    "500": "",
                    "600": "",
                    "700": "",
                    "800": "",
                    "900": "",
                    "A100": "",
                    "A200": "",
                    "A400": "",
                    "A700": "",
                    "contrast": {
                        "light": [
                            "300",
                            "400",
                            "500",
                            "600",
                            "700",
                            "800",
                            "900"
                        ],
                        "dark": [
                            "50",
                            "100",
                            "200"
                        ]
                    }
                },
                "warn": {
                    "50": "",
                    "100": "",
                    "200": "",
                    "300": "",
                    "400": "",
                    "500": "",
                    "600": "",
                    "700": "",
                    "800": "",
                    "900": "",
                    "A100": "",
                    "A200": "",
                    "A400": "",
                    "A700": "",
                    "contrast": {
                        "light": [
                            "300",
                            "400",
                            "500",
                            "600",
                            "700",
                            "800",
                            "900"
                        ],
                        "dark": [
                            "50",
                            "100",
                            "200"
                        ]
                    }
                }
            },
            "dark": {
                "primary": "blue",
                "secondary": "pink"
            }
        }
    },
    "assets": [
        "src/assets"
    ],
    "filters": {
        "all-cases": {
            "title": "All Cases",
            "access": "public",
            "body": {},
            "type": "Case"
        },
        "all-tasks": {
            "title": "All Tasks",
            "access": "public",
            "body": {},
            "type": "Task"
        },
        "data-cases": {
            "title": "Data Cases",
            "access": "public",
            "body": {
                "petriNet": {
                    "identifier": "data"
                }
            },
            "type": "Case"
        }
    },
    "i18n": [
        "sk",
        "de",
        "en"
    ],
    "services": {
        "auth": {
            "toLoginRedirect": "login",
            "onLoginRedirect": "tabbed-views",
            "onLogoutRedirect": "login"
        },
        "log": {
            "level": "DEBUG",
            "logWithDate": true,
            "serializeExtraParams": true,
            "includeLogLevel": true,
            "publishers": [
                "console"
            ]
        },
        "routing": {
            "defaultRedirect": "authentication",
            "wildcardRedirect": "authentication"
        },
        "dataFields": {
            "template": "material",
            "appearance": "outline"
        },
        "legal": {
            "termsOfService": "https://netgrif.com/",
            "privacyPolicy": "https://netgrif.com/"
        },
        "groupNavigation": {
            "groupNavigationRoute": "group-nav"
        },
        "doubleDrawer": {
            "url": "drawer-double"
        }
    }
}
